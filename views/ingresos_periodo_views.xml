<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================= -->
    <!-- Wizard: Ingresos por período                                       -->
    <!-- ================================================================= -->
    <record id="view_ingresos_periodo_wizard_form" model="ir.ui.view">
        <field name="name">lupatini.ingresos.periodo.wizard.form</field>
        <field name="model">lupatini.ingresos.periodo.wizard</field>
        <field name="arch" type="xml">
            <form string="Ingresos por período">
                <p class="text-muted">
                    Lo que entró por cada medio de cobro: sólo cobros a clientes, menos las
                    reversiones por nota de crédito. No incluye pagos a proveedores ni
                    transferencias entre cajas.
                </p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="operating_unit_ids"
                               widget="many2many_tags"
                               domain="[('company_id', '=', company_id)]"
                               placeholder="Todas"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf"
                            string="PDF"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_export_excel"
                            string="Excel"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ingresos_periodo_wizard" model="ir.actions.act_window">
        <field name="name">Ingresos por período</field>
        <field name="res_model">lupatini.ingresos.periodo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_ingresos_periodo"
        name="Ingresos por período"
        parent="lupatini_reporte_diario.menu_lupatini_reportes"
        action="action_ingresos_periodo_wizard"
        sequence="12"/>

</odoo>
